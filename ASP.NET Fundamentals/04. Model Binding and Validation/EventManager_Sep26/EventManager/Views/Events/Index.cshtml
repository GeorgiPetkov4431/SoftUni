@model IEnumerable<EventIndexViewModel>

@{
    ViewData["Title"] = "Events";
    IEnumerable<CategoryDropdownViewModel> allCategories = ViewData["AllCategories"] as IEnumerable<CategoryDropdownViewModel>
                                                            ?? Enumerable.Empty<CategoryDropdownViewModel>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Events</h1>
        <div class="text-muted">Browse upcoming events and register in seconds.</div>
    </div>

    <a class="btn btn-primary" asp-controller="Events" asp-action="Create">
        + Create Event
    </a>
</div>

<form asp-controller="Events"
      asp-action="Index"
      method="get"
      class="row g-3 mb-4 p-3 border rounded bg-light">
    <div class="col-12 col-md-4">
        <label for="searchTerm" class="form-label">Search</label>
        <input type="text"
               id="searchTerm"
               name="searchTerm"
               class="form-control"
               placeholder="Title or description"
               value="@Context.Request.Query["searchTerm"]" />
    </div>

    <div class="col-12 col-md-3">
        <label for="categoryId" class="form-label">Category</label>
        <select id="categoryId" name="categoryId" class="form-select">
            <option value="">All categories</option>

            @foreach (CategoryDropdownViewModel category in allCategories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>

    <div class="col-12 col-md-2">
        <label for="fromDate" class="form-label">From</label>
        <input type="date"
               id="fromDate"
               name="fromDate"
               class="form-control"
               value="@Context.Request.Query["fromDate"]" />
    </div>

    <div class="col-12 col-md-2">
        <label for="toDate" class="form-label">To</label>
        <input type="date"
               id="toDate"
               name="toDate"
               class="form-control"
               value="@Context.Request.Query["toDate"]" />
    </div>

    <div class="col-12 col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">
            Filter
        </button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No events yet. Create the first one from the <strong>Create Event</strong> button.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (EventIndexViewModel ev in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title mb-1">@ev.Title</h5>
                            <span class="badge bg-secondary">@ev.CategoryName</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(ev.Description))
                        {
                            <p class="card-text text-muted mt-2">
                                @(ev.Description!.Length > 120 ? ev.Description.Substring(0, 120) + "..." : ev.Description)
                            </p>
                        }
                        else
                        {
                            <p class="card-text text-muted mt-2 fst-italic">No description provided.</p>
                        }

                        <ul class="list-unstyled small mb-0">
                            <li><strong>Start:</strong> @ev.StartDate</li>
                            <li><strong>End:</strong> @ev.EndDate</li>
                            <li><strong>Occupancy:</strong> @ev.CurrentParticipants / @ev.MaxParticipants</li>
                        </ul>
                    </div>

                    <div class="card-footer bg-white border-0 pt-0">
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary w-100"
                               asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@ev.Id">
                                Details
                            </a>

                            <a class="btn btn-outline-success w-100"
                               asp-controller="Registrations"
                               asp-action="Create"
                               asp-route-eventId="@ev.Id">
                                Register
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
