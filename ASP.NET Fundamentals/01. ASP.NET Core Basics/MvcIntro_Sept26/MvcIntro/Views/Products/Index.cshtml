@{
    ViewData["Title"] = "Products";
    IEnumerable<string> products = ViewData["Products"] as IEnumerable<string>
                                    ?? new List<string>();
}

<div class="text-center">
    <h1 class="display-4 products-head">All Products</h1>
    <p>Here you can browse our products</p>

    <div class="row">
        <ul class="list-group">
            @foreach (string product in products)
            {
                <li class="list-group-item">@product</li>
            }
        </ul>
    </div>
    
</div>